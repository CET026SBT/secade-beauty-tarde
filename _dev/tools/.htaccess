# Bloquear acesso web a pasta de utilitarios de desenvolvimento.
# (O .htaccess da raiz ja reescreve qualquer .php existente para index.php,
#  mas isto e defesa em profundidade: estes scripts escrevem ficheiros.)

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Garantir que os .php nao sao servidos como texto caso o handler falhe
<FilesMatch "\.(php|md|json)$">
    SetHandler none
</FilesMatch>